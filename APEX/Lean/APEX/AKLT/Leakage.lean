/-- **Completeness of the singlet basis.** Every integer vector `ψ` of the 625-dimensional space
that is a total-spin singlet (`S₊ψ = S₋ψ = Szψ = 0`) is an *integer* combination of
`sv0..sv4`, with coefficients its pin coordinates `ψ(0, 4-l, l, 4)`. -/
theorem singlet_complete (ψ : V) (hp : SpTot ψ = 0) (hm : SmTot ψ = 0) (hz : SzTot ψ = 0) :
    ψ = emb (fun l => ψ 0 (4 - l) l 4) := by
  have e := emb_singlet (fun l => ψ 0 (4 - l) l 4)
  refine sub_eq_zero.1 (singlet_zero_of_pins _ ?_ ?_ ?_ ?_)
  · rw [map_sub, hp, e.1, sub_zero]
  · rw [map_sub, hm, e.2.1, sub_zero]
  · rw [map_sub, hz, e.2.2, sub_zero]
  · intro l
    show ψ 0 (4 - l) l 4 - emb _ 0 (4 - l) l 4 = 0
    rw [emb_point, sub_self]

/-- The singlet submodule `ker S₊ ∩ ker S₋ ∩ ker Sz` of `V` (over `ℤ`). -/
def singlets : Submodule ℤ V :=
  LinearMap.ker SpTot ⊓ LinearMap.ker SmTot ⊓ LinearMap.ker SzTot

/-- The singlet submodule is exactly the (`ℤ`-)span of `sv0..sv4` (the image of `emb`). -/
theorem singlets_eq_range_emb : singlets = LinearMap.range emb := by
  ext ψ
  simp only [singlets, Submodule.mem_inf, LinearMap.mem_ker, LinearMap.mem_range]
  constructor
  · rintro ⟨⟨hp, hm⟩, hz⟩
    exact ⟨_, (singlet_complete ψ hp hm hz).symm⟩
  · rintro ⟨c, rfl⟩
    obtain ⟨h1, h2, h3⟩ := emb_singlet c
    exact ⟨⟨h1, h2⟩, h3⟩

/-- **The singlet sector has rank exactly 5**, with basis `sv0..sv4`. -/
theorem finrank_singlets : finrank ℤ singlets = 5 := by
  rw [singlets_eq_range_emb, ← (LinearEquiv.ofInjective emb emb_injective).finrank_eq,
    finrank_fin_fun]

