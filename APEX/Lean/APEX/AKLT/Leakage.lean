/-! ## Part 2: the reduced 5-dimensional model over `ℚ` and interpretation A -/

/-- `X_ij = Y_ij / 2` on the singlet sector, in the basis `sv0..sv4` (`Y_ij` acts by `N_ij`,
`intertw_Y01` … `intertw_Y23` in `Physical.lean`). -/
def Xq (N : Matrix (Fin 5) (Fin 5) ℤ) : Matrix (Fin 5) (Fin 5) ℚ :=
  (1 / 2 : ℚ) • N.map (Int.cast : ℤ → ℚ)

/-- The six `X_ij` in the order `01, 02, 03, 12, 13, 23`. -/
def Xs : Fin 6 → Matrix (Fin 5) (Fin 5) ℚ := ![Xq N01, Xq N02, Xq N03, Xq N12, Xq N13, Xq N23]

/-- The 24 operators of interpretation A: `ops (4p + (k-1)) = X_p ^ k`, `k = 1..4`. -/
def ops (j : Fin 24) : Matrix (Fin 5) (Fin 5) ℚ := Xs ⟨j.val / 4, by omega⟩ ^ (j.val % 4 + 1)

/-- literal table of the 24 operators `X_p^k` (`p` = 01,02,03,12,13,23; `k` = 1..4). -/

def opsT : Fin 24 → Matrix (Fin 5) (Fin 5) ℚ := ![
  !![-6, -1/2, 0, 0, 0; 0, -5, -2, 0, 0; 0, 0, -3, -9/2, 0; 0, 0, 0, 0, -8; 0, 0, 0, 0, 4],
  !![36, 11/2, 1, 0, 0; 0, 25, 16, 9, 0; 0, 0, 9, 27/2, 36; 0, 0, 0, 0, -32; 0, 0, 0, 0, 16],
